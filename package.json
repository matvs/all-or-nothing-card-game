{
  "name": "all-or-nothing-card-game",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "All or Nothing — a SET card game. Find sets of three cards where colour, shape, filling and number are each all the same or all different. Single-player puzzle plus real-time multiplayer rooms over Socket.IO, with text chat and push-to-talk WebRTC voice. React + Redux Toolkit + react-bootstrap frontend, Node + Socket.IO backend, faithful canvas-drawn card figures.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "preview": "NODE_ENV=production PORT=8462 node --import tsx server/index.ts",
    "screenshot": "node --import tsx scripts/screenshot.mts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "bootstrap": "^5.3.3",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.4",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "puppeteer-core": "^23.5.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
