{
  "name": "all-or-nothing-card-game",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "All or Nothing — a SET card game. Find sets of three cards by colour, shape, number and shading. Solo puzzle modes plus real-time multiplayer races over STOMP/WebSocket. Canvas-rendered tiles, Bootstrap 5.3 UI.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "preview": "NODE_ENV=production PORT=8462 node --import tsx server/index.ts",
    "screenshot": "node --import tsx scripts/screenshot.mts"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.0.0",
    "bootstrap": "^5.3.3",
    "express": "^4.21.0",
    "tsx": "^4.19.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.1",
    "puppeteer-core": "^23.5.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
