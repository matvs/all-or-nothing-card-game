# Copy to .env for local overrides (loaded automatically if present).

# Port the HTTP+WebSocket server listens on. The Docker image and nginx vhost
# both assume 8462 — only change this if you also update docker-compose.yml
# and nginx/allornothing.matvs.dev.conf.
PORT=8462

# Where the SQLite database file lives (aggregate player stats).
DB_PATH=./data/allornothing.sqlite3

# Node environment. "production" makes the server serve the built dist/
# folder; anything else assumes you are running `npm run dev:web` separately.
NODE_ENV=development

# Seconds a disconnected player has to reconnect before their seat becomes
# permanently AI-controlled for the rest of the match.
RECONNECT_GRACE_SECONDS=60
