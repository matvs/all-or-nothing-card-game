# Copy to .env for local overrides (loaded automatically if present).

# Port the HTTP + STOMP-over-WebSocket server listens on. The Docker image and
# nginx vhost both assume 8462 — only change this if you also update
# docker-compose.yml and nginx/allornothing.matvs.dev.conf.
PORT=8462

# Node environment. "production" makes the server serve the built dist/ folder
# same-origin; anything else assumes you run `npm run dev:web` (Vite) separately
# and proxy /api and /stomp to this server.
NODE_ENV=development

# There is no database and no AI: multiplayer rooms are in-memory and solo high
# scores live in the browser's localStorage. Nothing else to configure.
